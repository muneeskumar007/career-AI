# --- App ---
APP_ENV=development
DEBUG=true
APP_NAME=CareerAI

# --- Security ---
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=careerai

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute

# --- LLM provider (Modules 6, 7, 8, 11 — resume rewriting, interview
# questions, adaptive interview flow, answer evaluation). Modules 1-5 and
# 9-10's analysis logic all work with zero LLM key configured. ---
# "gemini" or "ollama" — see app/ai/providers/factory.py.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- File uploads (Module 2) ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx

# --- Voice/video interview answers (Modules 9-10) ---
# See SETUP.md for how to obtain the MediaPipe model files. Video mode
# returns a clear "not available" error until these paths point to real files.
MAX_MEDIA_UPLOAD_SIZE_MB=100
FACE_LANDMARKER_MODEL_PATH=models/face_landmarker.task
POSE_LANDMARKER_MODEL_PATH=models/pose_landmarker_lite.task
